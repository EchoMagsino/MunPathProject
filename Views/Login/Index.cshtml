@model MunPath.DTOs.Auth.LoginRequestDto

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | MunPath</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="mp-login-page">
    <a class="mp-skip visually-hidden-focusable" href="#main">Skip to main content</a>

    <div class="mp-stripe" aria-hidden="true"><span></span><span></span><span></span></div>

    <nav class="navbar navbar-expand-lg mp-navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="MunPath home">
                <span class="mp-logo">
                    <span class="mp-logo__word"><span class="mp-logo__mun">Mun</span><span class="mp-logo__path">Path</span></span>
                </span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="mp-login-nav-note d-none d-sm-inline">New to MunPath?</span>
                <a class="btn btn-outline-primary" asp-controller="SignUp" asp-action="Index">Create account</a>
            </div>
        </div>
    </nav>

    <main id="main">
        <section class="mp-hero mp-login-hero">
            <div class="container">
                <div class="row align-items-center gy-5">
                    <div class="col-lg-6">
                        <div class="mp-login-copy">
                            <span class="mp-chip mp-chip--sample mp-login-kicker">
                                <i class="bi bi-compass" aria-hidden="true"></i> YOUR MUNPATH JOURNEY
                            </span>
                            <h1 class="mp-hero__title">Your next step is <span>waiting for you.</span></h1>
                            <p class="mp-hero__lead">
                                Sign in to pick up where you left off and keep exploring college paths that fit you.
                            </p>

                            <div class="mp-login-path" aria-label="The MunPath journey">
                                <div class="mp-login-path__head">
                                    <div class="mp-login-path__mark"><i class="bi bi-signpost-2-fill" aria-hidden="true"></i></div>
                                    <div>
                                        <strong>Your path, at your pace</strong>
                                        <span>One step at a time</span>
                                    </div>
                                    <i class="bi bi-stars mp-login-path__sparkle" aria-hidden="true"></i>
                                </div>
                                <div class="mp-login-steps">
                                    <div class="mp-login-step">
                                        <span class="mp-login-step__number">01</span>
                                        <span><strong>Know yourself</strong><small>Explore your interests</small></span>
                                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                    </div>
                                    <div class="mp-login-step">
                                        <span class="mp-login-step__number">02</span>
                                        <span><strong>Explore programs</strong><small>See what may fit</small></span>
                                        <i class="bi bi-arrow-up-right-circle" aria-hidden="true"></i>
                                    </div>
                                    <div class="mp-login-step">
                                        <span class="mp-login-step__number">03</span>
                                        <span><strong>Plan your future</strong><small>Compare your options</small></span>
                                        <i class="bi bi-circle" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <p class="mp-login-path__note"><i class="bi bi-info-circle" aria-hidden="true"></i> Guidance for your journey, not guarantees.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-xl-5 offset-xl-1">
                        <div class="mp-authcard mp-login-card">
                            <div class="mp-login-card__eyebrow"><i class="bi bi-person-check" aria-hidden="true"></i> STUDENT PORTAL</div>
                            <h2>Welcome back</h2>
                            <p class="mp-muted mb-4">Log in to continue your MunPath journey.</p>

                            <form asp-controller="Login" asp-action="Index" method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="mp-error mb-3" role="alert"></div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">Email address</label>
                                    <div class="mp-login-input">
                                        <i class="bi bi-envelope" aria-hidden="true"></i>
                                        <input asp-for="Email" type="email" class="form-control" autocomplete="email"
                                               placeholder="name@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="mp-error"></span>
                                </div>

                                <div class="mb-2">
                                    <label asp-for="Password" class="form-label">Password</label>
                                    <div class="mp-login-input">
                                        <i class="bi bi-lock" aria-hidden="true"></i>
                                        <input asp-for="Password" type="password" class="form-control"
                                               autocomplete="current-password" />
                                    </div>
                                    <span asp-validation-for="Password" class="mp-error"></span>
                                </div>

                                <div class="d-flex justify-content-end mb-4">
                                    <a class="mp-login-forgot" href="#">Forgot password?</a>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 mp-login-submit">
                                    Log in <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                </button>
                            </form>

                            <div class="mp-login-card__divider"><span>NEW TO MUNPATH?</span></div>
                            <a class="mp-login-create" asp-controller="SignUp" asp-action="Index">
                                Create your free account <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        </div>
                        <p class="mp-login-secure"><i class="bi bi-shield-lock" aria-hidden="true"></i> Your account information stays private.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="mp-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span class="small">&copy; 2026 MunPath · Capstone project</span>
            <a class="small" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
