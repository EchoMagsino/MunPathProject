                                                            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
                                                            <script>
                                                                    (function () {
                                                                        var el = document.getElementById('previewRadar');
                                                                        if (!el || !window.Chart) return;
                                                                        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                                                                        new Chart(el, {
                                                                            type: 'radar',
                                                                            data: {
                                                                                labels: ['Realistic', 'Investigative', 'Artistic', 'Social', 'Enterprising', 'Conventional'],
                                                                                datasets: [{
                                                                                    data: [70, 92, 30, 40, 35, 64],
                                                                                    backgroundColor: 'rgba(27, 47, 122, .16)',
                                                                                    borderColor: '#1B2F7A',
                                                                                    borderWidth: 2,
                                                                                    pointBackgroundColor: '#F4B63F',
                                                                                    pointBorderColor: '#1B2F7A',
                                                                                    pointRadius: 4
                                                                                }]
                                                                            },
                                                                            options: {
                                                                                responsive: true,
                                                                                animation: reduce ? false : { duration: 900 },
                                                                                scales: {
                                                                                    r: {
                                                                                        min: 0, max: 100,
                                                                                        ticks: { display: false, stepSize: 25 },
                                                                                        grid: { color: '#E1DACB' },
                                                                                        angleLines: { color: '#E1DACB' },
                                                                                        pointLabels: { font: { family: 'Figtree', size: 11, weight: '600' } }
                                                                                    }
                                                                                },
                                                                                plugins: { legend: { display: false } }
                                                                            }
                                                                        });
                                                                    })();
                                                            </script>
