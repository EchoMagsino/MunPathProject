    <div class="mp-stripe" aria-hidden="true"><span></span><span></span><span></span></div>

    <nav class="navbar navbar-expand-lg mp-navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" href="/" aria-label="MunPath home">
                <span class="mp-logo">
                    <svg width="36" height="40" aria-hidden="true">
                        <use href="#mp-mark" />
                    </svg>
                    <span class="mp-logo__word"><span class="mp-logo__mun">Mun</span><span
                        class="mp-logo__path">Path</span></span>
                    </span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
                        aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav mx-lg-auto gap-lg-1">
                        <li class="nav-item"><a class="nav-link" href="#how">How it works</a></li>
                        <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="#faq">FAQ</a></li>
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">
                        <a class="btn btn-outline-primary" href="/Login/Index">Log in</a>
                        <a class="btn btn-primary" href="/SignUp">Get started</a>
                    </div>
                </div>
            </div>
        </nav>

        <main id="main">
            <section class="mp-hero">
                <div class="container">
                    <div class="row align-items-center gy-5">
                        <div class="col-lg-6">
                            <h1 class="mp-hero__title">Find the college program that fits who you are.</h1>
                            <p class="mp-hero__lead">
                                MunPath turns your interests, Senior High School strand, and grades into a personalized
                                shortlist of college programs and institutions in Muntinlupa, with clear reasons for every
                                suggestion.
                            </p>
                            <div class="d-flex flex-wrap gap-3 mt-4">
                                <a class="btn btn-primary btn-lg" href="/SignUp">Take the assessment</a>
                                <a class="btn btn-outline-primary btn-lg" href="#how">Learn more</a>
                            </div>
                            <p class="mp-hero__note">
                                <i class="bi bi-clock"></i> About 10 minutes, 30 short statements. Your results are
                                guidance, not guarantees.
                            </p>
                        </div>

                        <div class="col-lg-6">
                            <div class="mp-preview" aria-label="Sample preview of a MunPath result">
                                <div class="mp-preview__head">
                                    <div>
                                        <div class="mp-preview__title">Your interest profile</div>
                                        <div class="small text-muted">Top interests: Investigative, Realistic, Conventional
                                        </div>
                                    </div>
                                    <span class="mp-chip mp-chip--sample"><i class="bi bi-info-circle"></i> Sample
                                        preview</span>
                                    </div>
                                    <div class="row g-3 align-items-center">
                                        <div class="col-sm-6">
                                            <canvas id="previewRadar" aria-label="Sample radar chart of six interest areas"
                                                    role="img"></canvas>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="small fw-semibold mb-2">Programs that may fit</div>
                                            @foreach (var m in new[] { ("BS Computer Science", 86), ("BS Information Technology", 82), ("BS Civil Engineering", 76) })
                                            {
                                                var offset = (163.36 * (1 - m.Item2 / 100.0)).ToString("0.##",
                                            System.Globalization.CultureInfo.InvariantCulture);
                                                var band = m.Item2 >= 80 ? "" : "mp-ring--good";
                                                <div class="mp-mini">
                                                    <div class="mp-ring @band" style="--ring-size:44px;width:44px;height:44px"
                                                         role="img" aria-label="@m.Item2 percent alignment">
                                                        <svg viewBox="0 0 64 64" aria-hidden="true">
                                                            <circle class="mp-ring__track" cx="32" cy="32" r="26" />
                                                            <circle class="mp-ring__bar" cx="32" cy="32" r="26"
                                                                    stroke-dasharray="163.36" stroke-dashoffset="@offset" />
                                                        </svg>
                                                        <span class="mp-ring__num">@m.Item2<small>%</small></span>
                                                    </div>
                                                    <span>@m.Item1</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <p class="small text-muted mt-3 mb-0">Illustrative numbers only. Your own results come from
                                        your assessment.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mp-strip" aria-label="What MunPath looks at">
                        <div class="container">
                            <div class="row g-0">
                                <div class="col-md-4 mp-strip__item">
                                    <span class="mp-strip__icon mp-strip__icon--navy"><i class="bi bi-ui-checks"></i></span>
                                    <div><b>Personalized assessment</b><span>Finds your interests across six areas (RIASEC).</span>
                                    </div>
                                </div>
                                <div class="col-md-4 mp-strip__item">
                                    <span class="mp-strip__icon mp-strip__icon--gold"><i class="bi bi-mortarboard"></i></span>
                                    <div><b>Program recommendations</b><span>Considers your strand and GWA, and shows why.</span>
                                    </div>
                                </div>
                                <div class="col-md-4 mp-strip__item">
                                    <span class="mp-strip__icon mp-strip__icon--crimson"><i class="bi bi-buildings"></i></span>
                                    <div><b>Institutions in Muntinlupa</b><span>See where your top programs are offered.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mp-section" id="how">
                        <div class="container">
                            <div class="mp-section__head">
                                <h2>How MunPath works</h2>
                                <p>Four steps from creating an account to a report you can bring to your parents, guidance
                                    counselor, or school.</p>
                                </div>
                                <ol class="mp-journey">
                                    <li>
                                        <span class="mp-journey__dot">1</span>
                                        <h3>Create an account</h3>
                                        <p>Sign up with your name and email. It takes about a minute.</p>
                                    </li>
                                    <li>
                                        <span class="mp-journey__dot">2</span>
                                        <h3>Complete your profile</h3>
                                        <p>Tell us your SHS strand and GWA so suggestions match your academic background.</p>
                                    </li>
                                    <li>
                                        <span class="mp-journey__dot">3</span>
                                        <h3>Take the assessment</h3>
                                        <p>Rate 30 short statements about what you enjoy. There are no right or wrong answers.</p>
                                    </li>
                                    <li>
                                        <span class="mp-journey__dot">4</span>
                                        <h3>Get your recommendations</h3>
                                        <p>See matching programs and institutions, the reasons behind them, and a printable report.</p>
                                    </li>
                                </ol>
                            </div>
                        </section>

                        <section class="mp-section mp-section--tint" id="features">
                            <div class="container">
                                <div class="row gy-5">
                                    <div class="col-lg-4">
                                        <div class="mp-sticky">
                                            <h2 class="mp-h2">Clear answers, not just a list</h2>
                                            <p class="mp-muted">Every result comes with an explanation, so you can judge for yourself
                                                whether a program makes sense for you.</p>
                                                <a class="btn btn-primary mt-2" href="SignUp">Create your account</a>
                                            </div>
                                        </div>
                                        <div class="col-lg-8">
                                            <div class="mp-feature">
                                                <span class="mp-feature__icon"><i class="bi bi-bar-chart-line"></i></span>
                                                <div>
                                                    <h3>An interest profile you can read at a glance</h3>
                                                    <p>See your strengths across Realistic, Investigative, Artistic, Social, Enterprising,
                                                        and Conventional areas, in a chart and in plain language.</p>
                                                    </div>
                                                </div>
                                                <div class="mp-feature">
                                                    <span class="mp-feature__icon"><i class="bi bi-stars"></i></span>
                                                    <div>
                                                        <h3>Programs ranked with reasons</h3>
                                                        <p>Each program shows how well it aligns with your interests, strand, and GWA, and which
                                                            of your results led to the suggestion.</p>
                                                        </div>
                                                    </div>
                                                    <div class="mp-feature">
                                                        <span class="mp-feature__icon"><i class="bi bi-columns-gap"></i></span>
                                                        <div>
                                                            <h3>Save and compare side by side</h3>
                                                            <p>Keep programs you like and compare up to three on skills, career paths, and
                                                                requirements.</p>
                                                            </div>
                                                        </div>
                                                        <div class="mp-feature">
                                                            <span class="mp-feature__icon"><i class="bi bi-buildings"></i></span>
                                                            <div>
                                                                <h3>Institutions in Muntinlupa</h3>
                                                                <p>Find where your top programs are offered and why each institution is relevant to your
                                                                    results.</p>
                                                                </div>
                                                            </div>
                                                            <div class="mp-feature">
                                                                <span class="mp-feature__icon"><i class="bi bi-printer"></i></span>
                                                                <div>
                                                                    <h3>A report you can print or save</h3>
                                                                    <p>Bring your assessment summary, programs, and institutions to a conversation with your
                                                                        family or guidance counselor.</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </section>

                                                <section class="mp-section" id="about">
                                                    <div class="container">
                                                        <div class="row gy-4 align-items-center">
                                                            <div class="col-lg-6">
                                                                <h2 class="mp-h2">Built to support your decision, not make it for you</h2>
                                                                <p class="mp-muted">
                                                                    MunPath is an analytics-based decision support system for Senior High School students'
                                                                    college
                                                                    program selection, with personalized assessment and institutional recommendation reports.
                                                                </p>
                                                                <p class="mp-muted mb-0">
                                                                    It uses rule-based filtering that combines your RIASEC assessment results, your SHS strand,
                                                                    and your GWA.
                                                                    Suggestions show alignment, not certainty. Talk with your family and guidance counselor, and
                                                                    confirm
                                                                    requirements with each institution.
                                                                </p>
                                                            </div>
                                                            <div class="col-lg-6">
                                                                <div class="mp-inputs" aria-label="What MunPath considers">
                                                                    <div class="mp-inputs__item"><i class="bi bi-ui-checks"></i><b>RIASEC results</b><span>What
                                                                        you enjoy</span></div>
                                                                        <div class="mp-inputs__plus" aria-hidden="true">+</div>
                                                                        <div class="mp-inputs__item"><i class="bi bi-journal-bookmark"></i><b>SHS
                                                                            strand</b><span>Where you studied</span></div>
                                                                            <div class="mp-inputs__plus" aria-hidden="true">+</div>
                                                                            <div class="mp-inputs__item"><i class="bi bi-graph-up"></i><b>GWA</b><span>How you
