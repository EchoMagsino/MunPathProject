    <div class="mp-stripe" aria-hidden="true"><span></span><span></span><span></span></div>

    <nav class="navbar navbar-expand-lg mp-navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" href="/" aria-label="MunPath home">
                <span class="mp-logo">
                    <svg width="36" height="40" aria-hidden="true"><use href="#mp-mark" /></svg>
                    <span class="mp-logo__word"><span class="mp-logo__mun">Mun</span><span class="mp-logo__path">Path</span></span>
                </span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
                    aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="publicNav">
                <ul class="navbar-nav mx-lg-auto gap-lg-1">
                    <li class="nav-item"><a class="nav-link" href="/#how">How it works</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                </ul>
                <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">
                    <a class="btn btn-outline-primary" href="/Account/Login">Log in</a>
                    <a class="btn btn-primary" href="/Account/Register" aria-current="page">Get started</a>
                </div>
            </div>
        </div>
    </nav>

    <main id="main">
        <section class="mp-auth">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-9 col-lg-6">
                        <div class="mp-authcard">
                            <h1>Create your account</h1>
                            <p class="mp-muted">Create your MunPath account to get started.</p>

                            <form asp-controller="SignUp" asp-action="Index" method="post" novalidate>
                                <div asp-validation-summary="ModelOnly" class="mp-error mb-3"></div>

                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <label asp-for="FirstName" class="form-label">First name</label>
                                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                        <span asp-validation-for="FirstName" class="mp-error"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <label asp-for="LastName" class="form-label">Last name</label>
                                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                        <span asp-validation-for="LastName" class="mp-error"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Email" class="form-label">Email address</label>
                                        <input asp-for="Email" type="email" class="form-control" autocomplete="email"
                                               placeholder="name@example.com" />
                                        <span asp-validation-for="Email" class="mp-error"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <label asp-for="Password" class="form-label">Password</label>
                                        <input asp-for="Password" type="password" class="form-control"
                                               autocomplete="new-password" aria-describedby="pwHelp" />
                                        <div id="pwHelp" class="form-text">At least 8 characters.</div>
                                        <span asp-validation-for="Password" class="mp-error"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                                               autocomplete="new-password" />
                                        <span asp-validation-for="ConfirmPassword" class="mp-error"></span>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" id="signupButton">
                                    Sign Up
                                </button>
                            </form>

                            <p class="text-center mb-0 mt-3">
                                Already have an account? <a href="/Account/Login">Log in</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="mp-footer">
        <div class="container">
            <div class="row gy-4 align-items-start">
                <div class="col-lg-5">
                    <span class="mp-logo">
                        <svg width="36" height="40" aria-hidden="true"><use href="#mp-mark" /></svg>
                        <span class="mp-logo__word"><span class="mp-logo__mun">Mun</span><span class="mp-logo__path">Path</span></span>
                    </span>
                    <p class="mt-3 mb-0 mp-footer__text">
                        MunPath is a decision support system that helps Senior High School students in Muntinlupa explore
                        college programs and institutions. It offers guidance, not guarantees.
                    </p>
                </div>
                <div class="col-6 col-lg-3 offset-lg-1">
                    <h2 class="mp-footer__h">Explore</h2>
                    <ul class="list-unstyled mb-0">
                        <li><a href="/#how">How it works</a></li>
                        <li><a href="/#features">Features</a></li>
                        <li><a href="/#faq">FAQ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="mp-footer__h">Account</h2>
                    <ul class="list-unstyled mb-0">
                        <li><a href="/Account/Login">Log in</a></li>
                        <li><a href="/Account/Register">Create an account</a></li>
                    </ul>
                </div>
            </div>
            <hr />
            <p class="small mb-0 mp-footer__text">Capstone project.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
